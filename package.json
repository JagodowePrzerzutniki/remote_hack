{
  "name": "agent-mesh",
  "version": "1.0.0",
  "description": "Terminal Multi-Agent Coordination Mesh for Distributed Hackathons",
  "main": "dist/index.js",
  "bin": {
    "agent-mesh": "./mesh"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts host --public",
    "host": "tsx src/cli/index.ts host --public",
    "host:local": "tsx src/cli/index.ts host --no-public",
    "tui": "tsx src/cli/index.ts tui",
    "watch": "tsx src/cli/index.ts watch",
    "mcp": "tsx src/cli/index.ts mcp",
    "simulate": "tsx scripts/simulate-team.ts",
    "build": "tsc"
  },
  "keywords": ["multi-agent", "hackathon", "mcp", "tui", "cross-network", "ai-agents"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^13.0.3",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "morgan": "^1.12.1",
    "untun": "^0.2.2",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
